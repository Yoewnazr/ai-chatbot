# Salin fail ini kepada ".env" dan isikan nilai sebenar anda.
# JANGAN commit fail .env ke repositori.

# Kunci API (wajib)
AI_API_KEY=your_api_key_here

# Base URL bagi pembekal AI (OpenAI-compatible)
# Contoh: DeepSeek rasmi, atau Rootsys gateway (https://rootsys.cloud/v1)
AI_BASE_URL=https://api.deepseek.com/v1

# Nama model
# Rootsys: deepseek-v4.1-flash (menyokong Vision/imej)
# Elakkan varian "-mod" kerana ia menimpa system prompt anda
AI_MODEL=deepseek-v4.1-flash

# Port pelayan (pilihan, lalai 5000)
# PORT=5000
